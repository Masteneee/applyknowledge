# Copy this file to .env and fill it in. Never commit .env.
# Get a key at https://platform.claude.com/ (leave empty to run in demo mode).
ANTHROPIC_API_KEY=

# Which Claude model to use. claude-opus-5-5 gives the best guidance.
# claude-haiku-5-5 is about 40x cheaper if cost matters more than quality.
CLAUDE_MODEL=claude-opus-5-5

PORT=3000

# Spending protection for a public site.
MAX_REQUESTS_PER_IP_PER_HOUR=20
MAX_REQUESTS_PER_DAY=500
